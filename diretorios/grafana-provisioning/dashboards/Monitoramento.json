{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "id": 6,
      "options": {
        "content": "# Direto da Provedora de Internet\n",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 2 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "clamp_max(speedtest_ping_latency_milliseconds ,400)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ping (ms)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 2 },
      "id": 8,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "speedtest_upload_bits_per_second / 1000000",
          "legendFormat": "DNS Google",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Upload (Mbps)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 2 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "speedtest_download_bits_per_second / 1000000",
          "legendFormat": "SpeedTest",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Download (Mbps)",
      "type": "gauge"
    },
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "options": {
        "content": "# Web",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "clamp_max(probe_duration_seconds{job=\"ping_google\"} * 1000, 400)",
          "legendFormat": "DNS Google",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ping (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 10 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "clamp_max(stddev_over_time(probe_duration_seconds{job=\"ping_google\"}[1m]) * 1000,200)",
          "legendFormat": "DNS Google",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "jitter (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 10 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "(probe_http_content_length{origem=\"github\"}) * 8 / ignoring(phase) (probe_http_duration_seconds{phase=\"transfer\",origem=\"github\"} * 1000000)",
          "legendFormat": "Github",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "(probe_http_content_length{origem=\"google\"}) * 8 / ignoring(phase) (probe_http_duration_seconds{phase=\"transfer\",origem=\"google\"} * 1000000)",
          "legendFormat": "Google",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Download (Mbps)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "id": 13,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "1 - avg_over_time(probe_success{job=\"ping_google\"}[5m])",
          "legendFormat": "DNS Google",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Perda de Pacotes (%)",
      "type": "timeseries"
    },
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 23 },
      "id": 9,
      "options": {
        "content": "# Aplicações Web",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": 0 },
              { "color": "dark-green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 25 },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "probe_success{job=\"teste_sistemas_web\"}",
          "legendFormat": "SIGAA",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Status SIGAA",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 25 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "probe_dns_lookup_time_seconds{job=\"teste_sistemas_web\"}",
          "legendFormat": "SIGAA",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "O Tempo de Resolução DNS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 25 },
      "id": 11,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "probe_duration_seconds{job=\"teste_sistemas_web\"}",
          "legendFormat": "SIGAA",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "O Tempo de Resposta HTTP",
      "type": "timeseries"
    }
  ],
